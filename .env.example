# Copy to .env (never commit it). Only the local runner and the demo read these;
# the n8n workflows themselves hold no secrets - they reference credentials by name.

# Local runner (python -m runner.cli --live)
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible gateway instead of api.anthropic.com (then pass --model <alias>)
ANTHROPIC_BASE_URL=

# Throwaway-n8n demo (python -m demo.run_demo)
DEMO_CLAUDE_KEY=
DEMO_CLAUDE_URL=https://api.anthropic.com/v1/messages
DEMO_CLAUDE_MODEL=
# Optional: reach a gateway on another Docker network through a one-port relay
DEMO_RELAY_NETWORK=
DEMO_RELAY_TARGET=
# Node.js with playwright-core for the screenshots
NODE_BIN=
NODE_PATH=
